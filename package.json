{
  "name": "my-first-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file migrations/seeds/development.sql",
    "dev": "vite",
    "start": "vite",
    "test": "vitest",
    "test:once": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc -p ./src/worker/tsconfig.json && svelte-check --tsconfig ./src/ui/tsconfig.json",
    "build": "vite build"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^31.0.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "~5.0.3",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "prettier": "^3.10.1"
  }
}
